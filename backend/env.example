# Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenAI
OPENAI_API_KEY=sk-...

# Tavily (Web Search)
TAVILY_API_KEY=tvly-...

# Qdrant (Vector Database) - Optional if using in-memory
QDRANT_URL=
QDRANT_API_KEY=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://keynote.vercel.app

# Environment
ENV=production

